<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Game names are kept as the game spells them (m_iHealth, sv_cheats), and generated members are documented from the game's own metadata where it has any. -->
    <NoWarn>$(NoWarn);CS1591;CS8981;IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeadworksManaged" />
    <InternalsVisibleTo Include="DeadworksManaged.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeadworksManaged.Api\DeadworksManaged.Api.csproj" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeadlockManagedDir)' != ''">
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)DeadworksManaged.Game.dll;$(OutputPath)DeadworksManaged.Game.pdb;$(OutputPath)DeadworksManaged.Game.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(DeadlockManagedDir)" SkipUnchangedFiles="false" Retries="0" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
