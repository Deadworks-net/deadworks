<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DeadworksManaged.GameGen</RootNamespace>
    <AssemblyName>gamegen</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeadworksManaged.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="overrides.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="spawn-survey.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('spawn-survey.json')" />
  </ItemGroup>

</Project>
