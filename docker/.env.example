# Copy to .env. Only the Steam account is required.

# Any Steam account with Deadlock in its library; it is only used to download the game files and
# never logs in to the game server itself. A throwaway account is a good idea. After the first
# successful start a login token is cached in the steam volume and STEAM_PASSWORD can be removed.
# If Steam Guard asks for a typed code, or you would rather not put a password here at all (leave
# it empty and scan a QR code with the Steam mobile app), run this once:
#   docker compose run --rm deadworks login
STEAM_USERNAME=
STEAM_PASSWORD=

SERVER_NAME=Deadworks Server
SERVER_PORT=27015
SERVER_MAP=dl_midtown
SERVER_PASSWORD=

# Only needed for remote RCON tools (and then also publish the tcp port in compose.yaml). Left
# empty, a random password is generated and `docker compose exec deadworks console` just works.
RCON_PASSWORD=

# Appended to the server command line verbatim. For cvars, prefer ./configs/server.cfg.
EXTRA_ARGS=

# Check for a game update on every start. Set to 0 to pin the installed build.
AUTO_UPDATE=1

# latest: fetch the newest Deadworks release on every start, so that after a game update the fix
# arrives with a restart. Or a release tag (v0.4.16) to pin one, or "image" for the copy baked
# into the image, which never goes online.
DEADWORKS_VERSION=latest

# Owner of everything written to ./plugins, ./configs and the data volume.
PUID=1000
PGID=1000
