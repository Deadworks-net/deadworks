# Optional net-message visitor diagnostics.
# Normal plugin interest is declared in managed code through NetMessages.Visit* or Hook* APIs.

# Emit aggregate counters from incoming/outgoing net-message hooks.
# DEADWORKS_NETMSG_PROBE_LOG=1

# Probe log interval in milliseconds (default: 5000).
# DEADWORKS_NETMSG_PROBE_LOG_WINDOW_MS=5000
